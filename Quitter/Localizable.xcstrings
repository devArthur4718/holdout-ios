    "A trophy at every goal: 1 day, 1 week, 30 days, 6 months, 1 year…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trofeo en cada meta: 1 día, 1 semana, 30 días, 6 meses, 1 año…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um troféu a cada meta: 1 dia, 1 semana, 30 dias, 6 meses, 1 ano…"
          }
        }
      }
    },
    "Add a habit to see when it's hardest and how your streaks add up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega un hábito para ver cuándo es más difícil y cómo se suman tus rachas."
