    "All habits, slips, urges and reasons are deleted from this phone. This can't be undone. Export first if you want a copy.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los hábitos, recaídas, antojos y motivos se borrarán de este teléfono. No se puede deshacer. Exporta antes si quieres una copia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os hábitos, recaídas, vontades e motivos serão apagados deste celular. Não dá para desfazer. Exporte antes se quiser uma cópia."
          }
        }
      }
    },
